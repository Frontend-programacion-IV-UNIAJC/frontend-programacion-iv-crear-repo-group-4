---
// index.astro
import Layout from "../layouts/Layout.astro";
import Boton from "../components/ui/Boton.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
---

<Layout
  titulo="Bitácora Espacial — Imágenes astronómicas de la NASA"
  descripcion="Galería ligera para explorar imágenes astronómicas de los centros de la NASA, con fecha, centro y etiquetas a la vista."
  activo="inicio"
  ancho="ancho"
>
  <!-- ============ Portada ============ -->
  <section class="portada">
    <div class="contenedor portada__interior">
      <div class="portada__texto">
        <p class="rotulo">Archivo NASA</p>
        <h1>Explora el espacio sin esperas ni textos infinitos</h1>
        <p class="portada__entrada">
          Imágenes de nebulosas y eventos cósmicos con su fecha, centro de
          origen y etiquetas a la vista. Miniaturas ligeras primero, la imagen
          grande solo si la abres.
        </p>
        <div class="portada__acciones">
          <Boton href={`${base}catalogo`} tamano="grande">Ver el catálogo</Boton>
          <Boton href={`${base}acerca-de`} variante="secundario" tamano="grande">
            Acerca del proyecto
          </Boton>
        </div>
        <ul class="portada__datos">
          <li><strong>&lt; 2 s</strong> meta de carga inicial</li>
          <li><strong>2</strong> filtros: texto y centro</li>
          <li><strong>0</strong> imágenes HD en la galería</li>
        </ul>
      </div>
      <div class="portada__medio">
        <img
          src={`${base}img/portada.svg`}
          alt="Ilustración de una nebulosa con estrellas sobre fondo oscuro"
          width="640"
          height="480"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ============ Destacadas ============ -->
  <!-- Las tarjetas llegan con Card y CardGrid. -->
  <section class="contenedor seccion">
    <div class="seccion__encabezado">
      <div>
        <p class="rotulo">Para empezar</p>
        <h2>Tres imágenes recientes del archivo</h2>
      </div>
      <Boton href={`${base}catalogo`} variante="fantasma">Ver todas</Boton>
    </div>
    <p class="pendiente">Aquí van las tres imágenes destacadas.</p>
  </section>

  <!-- ============ Cómo funciona ============ -->
  <section class="contenedor seccion">
    <p class="rotulo">Cómo funciona</p>
    <h2>Tres pasos y a explorar</h2>
    <ol class="pasos">
      <li class="paso">
        <span class="paso__numero">1</span>
        <h3>Busca o filtra</h3>
        <p>Escribe una palabra clave o elige el centro de la NASA.</p>
      </li>
      <li class="paso">
        <span class="paso__numero">2</span>
        <h3>Revisa la tarjeta</h3>
        <p>Miniatura, título, fecha, centro y etiquetas, sin textos largos.</p>
      </li>
      <li class="paso">
        <span class="paso__numero">3</span>
        <h3>Abre el detalle</h3>
        <p>Con "Leer más" ves la descripción completa y la imagen en grande.</p>
      </li>
    </ol>
  </section>
</Layout>

<style>
  /* ---- Portada ---- */
  .portada {
    background: linear-gradient(180deg, var(--color-marca-suave) 0%, var(--color-lienzo) 100%);
    border-bottom: 1px solid var(--color-borde-fuerte);
  }

  .portada__interior {
    display: grid;
    gap: var(--esp-5);
    padding-top: var(--esp-6);
    padding-bottom: var(--esp-6);
    align-items: center;
  }

  @media (min-width: 900px) {
    .portada__interior {
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--esp-6);
      padding-top: var(--esp-7);
      padding-bottom: var(--esp-7);
    }
  }

  .portada__texto h1 { max-width: 20ch; }

  .portada__entrada {
    font-size: var(--texto-m);
    color: var(--color-texto-suave);
    max-width: 46ch;
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2);
    margin-bottom: var(--esp-5);
  }

  .portada__datos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-4);
    list-style: none;
    margin: 0;
    padding: var(--esp-3) 0 0;
    border-top: 1px solid var(--color-marca-borde);
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
  }

  .portada__datos strong {
    display: block;
    font-family: var(--fuente);
    font-size: var(--texto-l);
    color: var(--color-texto);
    line-height: 1.2;
  }

  .portada__medio img {
    width: 100%;
    height: auto;
    border-radius: var(--radio-l);
    box-shadow: var(--sombra-3);
  }

  /* ---- Secciones ---- */
  .seccion { padding-top: var(--esp-6); }

  .seccion__encabezado {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--esp-3);
    margin-bottom: var(--esp-4);
  }

  .seccion__encabezado h2 { margin: 0; }

  .pendiente {
    padding: var(--esp-5);
    border: 2px dashed var(--color-borde-fuerte);
    border-radius: var(--radio-m);
    color: var(--color-texto-tenue);
    text-align: center;
    margin: 0;
  }

  /* ---- Pasos ---- */
  .pasos {
    display: grid;
    gap: var(--esp-4);
    list-style: none;
    margin: var(--esp-4) 0 0;
    padding: 0;
  }

  @media (min-width: 768px) {
    .pasos { grid-template-columns: repeat(3, 1fr); }
  }

  .paso {
    background: var(--color-fondo);
    border: 1px solid var(--color-borde-fuerte);
    border-radius: var(--radio-m);
    padding: var(--esp-4);
  }

  .paso__numero {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radio-pildora);
    background: var(--color-marca-suave);
    color: var(--color-enlace);
    font-family: var(--fuente);
    font-weight: 600;
    margin-bottom: var(--esp-3);
  }

  .paso h3 { margin-bottom: var(--esp-1); }

  .paso p {
    margin: 0;
    color: var(--color-texto-suave);
    font-size: var(--texto-s);
  }
</style>