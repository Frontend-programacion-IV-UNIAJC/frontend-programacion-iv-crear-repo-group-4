<script>
  const lista = document.querySelector<HTMLElement>(".catalogo__lista");
  const nav = document.querySelector<HTMLElement>(".paginacion");

  if (lista) {
    const porPagina = Number(lista.dataset.porPagina) || 3;
    const items = Array.from(lista.querySelectorAll<HTMLElement>(".rejilla > li"));
    const total = Math.max(1, Math.ceil(items.length / porPagina));
    let actual = 1;

    function mostrar(pagina: number) {
      actual = Math.min(Math.max(pagina, 1), total);

      // Muestra solo las tarjetas de la página actual
      items.forEach((li, i) => {
        li.hidden = Math.ceil((i + 1) / porPagina) !== actual;
      });

      if (!nav) return;

      // Marca el número activo
      nav.querySelectorAll<HTMLButtonElement>("[data-pagina]").forEach((boton) => {
        if (Number(boton.dataset.pagina) === actual) {
          boton.setAttribute("aria-current", "page");
        } else {
          boton.removeAttribute("aria-current");
        }
      });

      // Activa o desactiva Anterior y Siguiente
      const anterior = nav.querySelector<HTMLButtonElement>('[data-accion="anterior"]');
      const siguiente = nav.querySelector<HTMLButtonElement>('[data-accion="siguiente"]');
      if (anterior) anterior.disabled = actual === 1;
      if (siguiente) siguiente.disabled = actual === total;

      // Texto "2 de 2" que se ve en móvil
      const estado = nav.querySelector("[data-estado-actual]");
      if (estado) estado.textContent = String(actual);
    }

    nav?.addEventListener("click", (evento) => {
      const boton = (evento.target as HTMLElement).closest<HTMLButtonElement>("button");
      if (!boton || boton.disabled) return;

      if (boton.dataset.accion === "anterior") mostrar(actual - 1);
      else if (boton.dataset.accion === "siguiente") mostrar(actual + 1);
      else if (boton.dataset.pagina) mostrar(Number(boton.dataset.pagina));

      // Vuelve al inicio de los resultados
      document.querySelector(".catalogo__conteo")?.scrollIntoView({ block: "start" });
    });

    mostrar(1);
  }
</script>

