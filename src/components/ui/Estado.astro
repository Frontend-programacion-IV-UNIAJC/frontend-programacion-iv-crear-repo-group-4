---
// Estado.astro
// "Vacío" y "Error" comparten la misma estructura: icono, título,
// explicación y una salida. Solo cambian el icono, el color y los textos.
interface Props {
  tipo?: "vacio" | "error";
  titulo?: string;
  mensaje?: string;
}

const textos = {
  vacio: {
    titulo: "No encontramos imágenes",
    mensaje: 'Prueba con otra palabra clave o elige "Centro: Todos".',
  },
  error: {
    titulo: "No pudimos cargar la galería",
    mensaje: "Revisa tu conexión e inténtalo de nuevo.",
  },
};

const { tipo = "vacio", titulo, mensaje } = Astro.props;
const esError = tipo === "error";
const porDefecto = textos[tipo] ?? textos.vacio;
const tituloFinal = titulo ?? porDefecto.titulo;
const mensajeFinal = mensaje ?? porDefecto.mensaje;
---

<div class:list={["estado", { "estado--error": esError }]} role={esError ? "alert" : "status"}>
  <span class="estado__icono" aria-hidden="true">
    {esError ? (
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7.5v5.5M12 16.5v.01" />
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
    )}
  </span>
  <h2 class="estado__titulo">{tituloFinal}</h2>
  <p class="estado__mensaje">{mensajeFinal}</p>
  <div class="estado__accion">
    <slot />
  </div>
</div>

<style>
  .estado {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--esp-6) var(--esp-4);
    background: var(--color-fondo);
    border: 1px solid var(--color-borde-fuerte);
    border-radius: var(--radio-m);
  }

  .estado--error {
    border-color: var(--color-error);
  }

  .estado__icono {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: var(--esp-3);
    border-radius: var(--radio-pildora);
    background: var(--color-superficie);
    color: var(--color-texto-suave);
  }

  .estado--error .estado__icono {
    background: var(--color-error-suave);
    color: var(--color-error);
  }

  .estado__titulo {
    font-size: var(--texto-l);
    margin: 0 0 var(--esp-2);
  }

  .estado__mensaje {
    max-width: 46ch;
    margin: 0 0 var(--esp-4);
    color: var(--color-texto-suave);
    overflow-wrap: anywhere;
  }

  /* Si no hay botón en el slot, no deja un hueco */
  .estado__accion:empty {
    display: none;
  }

  .estado__mensaje:last-child {
    margin-bottom: 0;
  }
