---
// Paginacion.astro
// Hoy solo se ve. Cambia de página cuando agreguemos JavaScript.
interface Props {
  actual?: number;
  total?: number;
}

const { actual = 1, total = 3 } = Astro.props;

// Ventana de páginas: primera, última, actual y vecinas; "…" donde hay saltos.
const visibles = [...new Set([1, total, actual - 1, actual, actual + 1])]
  .filter((n) => n >= 1 && n <= total)
  .sort((a, b) => a - b);

const paginas: (number | "…")[] = [];
let previa = 0;
for (const n of visibles) {
  if (n - previa > 1) paginas.push("…");
  paginas.push(n);
  previa = n;
}
---

{total > 1 && (
  <nav class="paginacion" aria-label="Páginas del catálogo">
    <button class="paginacion__boton" type="button" data-pagina={actual - 1} disabled={actual === 1}>
      Anterior
    </button>

    <!-- Móvil: solo el estado -->
    <span class="paginacion__estado">
      <span class="solo-lectores">Página </span>{actual} de {total}
    </span>

    <!-- Escritorio: números con ventana -->
    <ol class="paginacion__lista">
      {paginas.map((n) => (
        <li>
          {n === "…" ? (
            <span class="paginacion__salto" aria-hidden="true">…</span>
          ) : (
            <button
              class="paginacion__boton paginacion__numero"
              type="button"
              data-pagina={n}
              aria-current={n === actual ? "page" : undefined}
              aria-label={`Página ${n}`}
            >
              {n}
            </button>
          )}
        </li>
      ))}
    </ol>

    <button class="paginacion__boton" type="button" data-pagina={actual + 1} disabled={actual === total}>
      Siguiente
    </button>
  </nav>
)}

<style>
  .paginacion {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--esp-2);
    margin-top: var(--esp-6);
  }

  .paginacion__lista {
    display: none; /* en móvil se ve el estado "3 de 11"*/
    gap: var(--esp-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .paginacion__estado {
    min-width: 4.5rem;
    text-align: center;
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
  }

  @media (min-width: 600px) {
    .paginacion__lista { display: flex; }
    .paginacion__estado { display: none; }
  }

  .paginacion__boton {
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--esp-3);
    font: inherit;
    font-weight: 600;
    color: var(--color-texto);
    background: var(--color-fondo);
    border: 1px solid var(--color-borde-fuerte);
    border-radius: var(--radio-s);
    cursor: pointer;
  }

  .paginacion__numero {
    padding: 0;
  }

  .paginacion__salto {
    display: grid;
    place-items: center;
    min-width: 28px;
    min-height: 44px;
    color: var(--color-texto-tenue);
  }

  .paginacion__boton:hover:not(:disabled) {
    border-color: var(--color-enlace);
    color: var(--color-enlace);
  }

  .paginacion__boton[aria-current="page"] {
    background: var(--color-marca);
    border-color: var(--color-marca);
    color: #ffffff;
  }

  .paginacion__boton:disabled {
    color: var(--color-texto-tenue);
    background: var(--color-lienzo);
    cursor: not-allowed;
  }
</style>
 